{
  "name": "ai-code-reviewer",
  "displayName": "AI Code Reviewer",
  "description": "AI code review for your local changes. Bring your own model: GitHub Copilot or an Anthropic API key.",
  "version": "0.0.0",
  "private": true,
  "publisher": "serhii",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zellenka/code-reviewer.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/zellenka/code-reviewer/issues"
  },
  "homepage": "https://github.com/zellenka/code-reviewer#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters",
    "AI"
  ],
  "keywords": [
    "code review",
    "ai",
    "copilot",
    "claude",
    "anthropic"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "AI Code Reviewer reads repository content and sends it to the model you choose, so it only runs in trusted workspaces."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "AI Code Reviewer needs git and a local file system."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "aiReview.hello",
        "title": "Hello",
        "category": "AI Review"
      },
      {
        "command": "aiReview.showLog",
        "title": "Show Log",
        "category": "AI Review"
      },
      {
        "command": "aiReview.selectModel",
        "title": "Select Model",
        "category": "AI Review"
      },
      {
        "command": "aiReview.testConnection",
        "title": "Test Model Connection",
        "category": "AI Review"
      },
      {
        "command": "aiReview.setAnthropicApiKey",
        "title": "Set Anthropic API Key",
        "category": "AI Review"
      },
      {
        "command": "aiReview.clearAnthropicApiKey",
        "title": "Clear Anthropic API Key",
        "category": "AI Review"
      },
      {
        "command": "aiReview.openPanel",
        "title": "Open Review Panel",
        "category": "AI Review",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "aiReview.runReview",
        "title": "Run Review",
        "category": "AI Review",
        "icon": "$(play)"
      },
      {
        "command": "aiReview.cancelReview",
        "title": "Cancel Review",
        "category": "AI Review",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aiReview.reviewStaged",
        "title": "Review Staged Changes",
        "category": "AI Review"
      },
      {
        "command": "aiReview.reviewUnstaged",
        "title": "Review Unstaged Changes",
        "category": "AI Review",
        "icon": "$(sparkle)"
      },
      {
        "command": "aiReview.reviewBranch",
        "title": "Review Branch Changes",
        "category": "AI Review"
      },
      {
        "command": "aiReview.reviewFile",
        "title": "Review Current File",
        "category": "AI Review"
      },
      {
        "command": "aiReview.reviewSelection",
        "title": "Review Selection",
        "category": "AI Review"
      },
      {
        "command": "aiReview.clearFindings",
        "title": "Clear Findings",
        "category": "AI Review",
        "icon": "$(clear-all)"
      },
      {
        "command": "aiReview.showSummary",
        "title": "Show Review Summary",
        "category": "AI Review",
        "icon": "$(book)"
      },
      {
        "command": "aiReview.applyFix",
        "title": "Apply Fix",
        "category": "AI Review",
        "icon": "$(check)"
      },
      {
        "command": "aiReview.previewFix",
        "title": "Preview Fix",
        "category": "AI Review",
        "icon": "$(diff)"
      },
      {
        "command": "aiReview.resolveFinding",
        "title": "Mark Resolved",
        "category": "AI Review",
        "icon": "$(pass)"
      },
      {
        "command": "aiReview.dismissFinding",
        "title": "Dismiss",
        "category": "AI Review",
        "icon": "$(close)"
      },
      {
        "command": "aiReview.reopenFinding",
        "title": "Reopen",
        "category": "AI Review",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "aiReview.revealFinding",
        "title": "Go to Finding",
        "category": "AI Review"
      }
    ],
    "views": {
      "aiReview": [
        {
          "type": "webview",
          "id": "aiReview.controls",
          "name": "Review"
        },
        {
          "id": "aiReview.findings",
          "name": "Findings",
          "icon": "media/ai-review.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiReview.findings",
        "contents": "No review yet. Choose what to review above and press Run Review. Findings show up here, inline in the editor and in the Problems panel.\n[Run Review](command:aiReview.runReview)"
      }
    ],
    "configuration": {
      "title": "AI Review",
      "properties": {
        "aiReview.provider": {
          "type": "string",
          "enum": [
            "copilot",
            "anthropic"
          ],
          "enumDescriptions": [
            "GitHub Copilot models via VS Code (no key needed).",
            "Claude models with your own Anthropic API key (pay per token)."
          ],
          "default": "copilot",
          "markdownDescription": "Model provider used for reviews. Use **AI Review: Select Model** to change it."
        },
        "aiReview.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model id for the selected provider. Empty = the provider's first model. Use **AI Review: Select Model** to pick one."
        },
        "aiReview.anthropic.models": {
          "type": "array",
          "default": [],
          "markdownDescription": "Overrides or additions to the built-in Anthropic model table (limits and pricing in USD per million tokens). Entries are matched by `id`.",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "maxInputTokens": {
                "type": "number"
              },
              "maxOutputTokens": {
                "type": "number"
              },
              "pricing": {
                "type": "object",
                "properties": {
                  "inputPerMTok": {
                    "type": "number"
                  },
                  "outputPerMTok": {
                    "type": "number"
                  },
                  "cacheReadPerMTok": {
                    "type": "number"
                  },
                  "cacheWritePerMTok": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "aiReview.anthropic.refusalFallback": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "If a model's safety filter declines a request (security-related code can trigger this), let Anthropic retry it on a fallback model. Billed at the fallback model's rates."
        },
        "aiReview.baseBranch": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base branch for **Review Branch Changes**. Empty = auto-detect (`origin/HEAD`, then `main`, then `master`)."
        },
        "aiReview.concurrency": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 16,
          "markdownDescription": "Parallel model requests per review. `0` = default (2 for Copilot, 4 for Anthropic)."
        },
        "aiReview.severityThreshold": {
          "type": "string",
          "enum": [
            "",
            "critical",
            "major",
            "minor",
            "nit"
          ],
          "enumDescriptions": [
            "Use the repository setting (`.codereview.yml`, default `minor`).",
            "",
            "",
            "",
            ""
          ],
          "default": "",
          "markdownDescription": "Hide findings below this severity. Can only make the repository's `.codereview.yml` threshold stricter, not looser."
        },
        "aiReview.confidenceThreshold": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1,
          "markdownDescription": "Hide findings below this confidence (0–1). Can only make the repository's threshold stricter. `0` = use the repository setting (default 0.6)."
        },
        "aiReview.redactHighEntropyStrings": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also replace long random-looking strings with `[REDACTED]` before sending code to the model. Known secret formats (API keys, private keys, passwords in code) are always redacted."
        },
        "aiReview.summary": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After the review, make one extra request for a summary: a walkthrough of the change per file and the top risks. Turn off to save a request."
        },
        "aiReview.costConfirmationThreshold": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "markdownDescription": "Ask before running a review whose estimated cost (upper bound, USD) is above this amount. Applies to providers with known prices (Anthropic). `0` = always ask."
        },
        "aiReview.reviewMode": {
          "type": "string",
          "enum": [
            "auto",
            "single-pass",
            "agentic"
          ],
          "enumDescriptions": [
            "Use the repository setting (`review.mode` in `.codereview.yml`, default single-pass).",
            "One request per part of the diff. Cheapest and fastest.",
            "The model may read other files in the repository (read-only) before reporting. Finds cross-file bugs; uses several requests per part."
          ],
          "default": "auto",
          "markdownDescription": "How reviews run. **agentic** lets the model look up callers, definitions and types in the repository with read-only tools. Secret files are never readable."
        },
        "aiReview.includeContext": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Send the enclosing function or class of each change (from the language server when available), and for multi-file changes a list of the declarations changed across the diff."
        },
        "aiReview.agent.maxTurns": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 30,
          "markdownDescription": "Agentic reviews: model requests per part of the diff spent exploring, before it must report."
        },
        "aiReview.agent.maxToolCalls": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "markdownDescription": "Agentic reviews: tool calls (read file, search, references) per part of the diff."
        },
        "aiReview.agent.tokenBudget": {
          "type": "number",
          "default": 200000,
          "minimum": 20000,
          "markdownDescription": "Agentic reviews: input tokens per part of the diff, summed over its requests (cached tokens included). The model is asked to report when it's used up."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "aiReview.reviewSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "aiReview.reviewFile",
          "when": "editorIsOpen"
        },
        {
          "command": "aiReview.applyFix",
          "when": "false"
        },
        {
          "command": "aiReview.previewFix",
          "when": "false"
        },
        {
          "command": "aiReview.resolveFinding",
          "when": "false"
        },
        {
          "command": "aiReview.dismissFinding",
          "when": "false"
        },
        {
          "command": "aiReview.reopenFinding",
          "when": "false"
        },
        {
          "command": "aiReview.revealFinding",
          "when": "false"
        },
        {
          "command": "aiReview.showSummary",
          "when": "aiReview.hasReview"
        },
        {
          "command": "aiReview.cancelReview",
          "when": "aiReview.running"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "aiReview.applyFix",
          "when": "commentController == aiReview && commentThread =~ /\\bfixable\\b/",
          "group": "inline@1"
        },
        {
          "command": "aiReview.previewFix",
          "when": "commentController == aiReview && commentThread =~ /\\bfixable\\b/",
          "group": "inline@2"
        },
        {
          "command": "aiReview.resolveFinding",
          "when": "commentController == aiReview && commentThread =~ /\\bopen\\b/",
          "group": "inline@3"
        },
        {
          "command": "aiReview.dismissFinding",
          "when": "commentController == aiReview && commentThread =~ /\\bopen\\b/",
          "group": "inline@4"
        },
        {
          "command": "aiReview.reopenFinding",
          "when": "commentController == aiReview && commentThread =~ /\\bresolved\\b/",
          "group": "inline@1"
        }
      ],
      "view/title": [
        {
          "command": "aiReview.runReview",
          "when": "view == aiReview.controls && !aiReview.running",
          "group": "navigation@1"
        },
        {
          "command": "aiReview.cancelReview",
          "when": "view == aiReview.controls && aiReview.running",
          "group": "navigation@1"
        },
        {
          "command": "aiReview.showSummary",
          "when": "view == aiReview.findings && aiReview.hasReview",
          "group": "navigation@2"
        },
        {
          "command": "aiReview.clearFindings",
          "when": "view == aiReview.findings && aiReview.hasReview",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "aiReview.applyFix",
          "when": "view == aiReview.findings && viewItem =~ /\\bfixable\\b/",
          "group": "inline@1"
        },
        {
          "command": "aiReview.resolveFinding",
          "when": "view == aiReview.findings && viewItem =~ /^finding/",
          "group": "inline@2"
        },
        {
          "command": "aiReview.dismissFinding",
          "when": "view == aiReview.findings && viewItem =~ /^finding/",
          "group": "inline@3"
        },
        {
          "command": "aiReview.previewFix",
          "when": "view == aiReview.findings && viewItem =~ /\\bfixable\\b/",
          "group": "fix@1"
        }
      ],
      "editor/context": [
        {
          "command": "aiReview.reviewSelection",
          "when": "editorHasSelection",
          "group": "aiReview@1"
        },
        {
          "command": "aiReview.reviewFile",
          "group": "aiReview@2"
        }
      ],
      "explorer/context": [
        {
          "command": "aiReview.reviewFile",
          "when": "!explorerResourceIsFolder",
          "group": "aiReview@1"
        }
      ],
      "scm/title": [
        {
          "command": "aiReview.reviewUnstaged",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiReview",
          "title": "AI Review",
          "icon": "media/ai-review.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -b && node esbuild.mjs",
    "build:prod": "tsc -b && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "test:ext": "pnpm run build && vscode-test",
    "package": "pnpm run build:prod && node scripts/copy-docs.mjs && vsce package --no-dependencies",
    "clean": "tsc -b --clean && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ai-review/core": "workspace:*",
    "@ai-review/node-host": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.28.2"
  }
}
