{
  "name": "ai-code-reviewer-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zellenka/code-reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/zellenka/code-reviewer/issues"
  },
  "homepage": "https://github.com/zellenka/code-reviewer#readme",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ext": "pnpm --filter ai-code-reviewer run test:ext",
    "test:live": "vitest run --config vitest.live.config.mts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
